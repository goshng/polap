################################################################################
# input tables and figures
#
# Base directory: man
# Tables: man/md
# Figures: man/figures
# Sample report markdown: $(POLAPLIB_DIR)/polap-md-man00-$(BOLAP_TYPE).md

# Use Bash for all recipes
SHELL := /bin/bash

# ------------------------------------------------------------------------------
# Bolap type: oatk (aflye, cflye for Makefile.aflye, and Makefile.cflye)
# ------------------------------------------------------------------------------
BOLAP_TYPE  ?= oatk

# ------------------------------------------------------------------------------
# Base paths
# ------------------------------------------------------------------------------
# This line sets POLAPLIB_DIR to the absolute path of the directory containing 
# the current Makefile.
POLAPLIB_DIR := $(abspath $(dir $(lastword $(MAKEFILE_LIST))))
# This line takes the POLAPLIB_DIR, appends /.. (which means "go up one
# directory"), and then converts the resulting path to an absolute path.
# Assuming the Makefile is in a subdirectory named lib or similar, this
# effectively sets POLAP_SRC to the absolute path of the project's root
# directory.
POLAP_SRC    := $(abspath $(POLAPLIB_DIR)/..)
# Define a variable called CURRENT_MAKEFILE
CURRENT_MAKEFILE := $(lastword $(MAKEFILE_LIST))
export POLAP_SRC POLAPLIB_DIR

# Species root defaults to current working dir (can override: SPECIES_ROOT=/abs/path)
# If a value for SPECIES_ROOT hasn't already been set (e.g., by a user on the
# command line like make SPECIES_ROOT=/usr/local), then set it to the directory
# where I am currently running make.
SPECIES_ROOT ?= $(CURDIR)
SR := $(abspath $(SPECIES_ROOT))

# ------------------------------------------------------------------------------
# Tier/Set (single tier)
# ------------------------------------------------------------------------------
SET   ?= auto     # auto|some|file:/abs/list.txt|<species>
INUM  ?= 0
TIER  ?= v2
# This function takes a string as input and returns the string with all leading
# and trailing whitespace (spaces, tabs) removed. It also replaces sequences of
# multiple internal spaces/tabs with a single space.
SET_CLEAN  := $(strip $(SET))
INUM_CLEAN := $(strip $(INUM))
TIER_CLEAN := $(strip $(TIER))

# ------------------------------------------------------------------------------
# Outputs
# ------------------------------------------------------------------------------
MAN_DIR       ?= $(SR)/man
FIGURE_DIR    ?= $(SR)/man/figures
MANIFEST_DIR  ?= $(SR)/man/md

# Manuscript folder
MAN5_FIGURE := $(HOME)/all/manuscript/polap-v0.5/figures
MAN5_MD     := $(HOME)/all/manuscript/polap-v0.5/md

# Common manifest tag reused across all tier/inum/set combinations
MANIFEST_TAG := $(TIER_CLEAN)-$(INUM_CLEAN)-$(SET_CLEAN)

# Paths built from the tag
MANIFEST_V6  := $(MANIFEST_DIR)/$(MANIFEST_TAG)-manifest.json
MANIFEST_LOG := $(MANIFEST_DIR)/$(MANIFEST_TAG)-manifest.log

# Derived summaries
PT_TABLE_TSV  := $(MANIFEST_DIR)/$(MANIFEST_TAG)-pt-summary.tsv
PT_TABLE_MD   := $(PT_TABLE_TSV:.tsv=.md)
MT_TABLE_TSV  := $(MANIFEST_DIR)/$(MANIFEST_TAG)-mt-summary.tsv
MT_TABLE_MD   := $(MT_TABLE_TSV:.tsv=.md)
DATA_TABLE_PREFIX := $(MANIFEST_DIR)/$(MANIFEST_TAG)-data-summary
DATA_TABLE_TSV    := $(DATA_TABLE_PREFIX).tsv
DATA_TABLE_MD     := $(DATA_TABLE_PREFIX).md
DATA_TABLE_NO_BASE_PREFIX := $(MANIFEST_DIR)/$(MANIFEST_TAG)-data-summary-no-base
DATA_TABLE_NO_BASE_TSV    := $(DATA_TABLE_NO_BASE_PREFIX).tsv
DATA_TABLE_NO_BASE_MD     := $(DATA_TABLE_NO_BASE_PREFIX).md
TABLE_S1_TSV  := $(MANIFEST_DIR)/$(MANIFEST_TAG)-table-s1.tsv
TABLE_S1_MD   := $(TABLE_S1_TSV:.tsv=.md)
SPECIES_CODES_TXT ?= $(POLAPLIB_DIR)/polap-species-codes-$(BOLAP_TYPE).txt

# Inputs / outputs (override on CLI if desired)
DOC_MD          ?= $(POLAPLIB_DIR)/polap-md-man00-$(BOLAP_TYPE).md
EXP_MD          ?= $(SR)/man/expanded.md
DOC_OUT_PDF     ?= $(SR)/man/polap-manuscript.pdf

# Pandoc engine and common flags
PANDOC          ?= pandoc
PDF_ENGINE      ?= xelatex

# Resource search path: allow images in man/figures/, man/
# PANDOC_RPATH    ?= $(SR):$(SR)/md:$(MAN_DIR):$(FIG_DIR)
# PANDOC_RPATH    ?= $(SR)/md:$(MAN_DIR)
PANDOC_RPATH    ?= $(FIGURE_DIR):$(MAN_DIR)

# Scripts
SCRIPT_MANIFEST := "$(POLAPLIB_DIR)/polap-bash-$(BOLAP_TYPE)-make-manifest.sh"
SCRIPT_MANIFEST_PY := "$(POLAPLIB_DIR)/scripts/oatk_manifest_assemble.py"
SCRIPT_GRAPH := "$(POLAPLIB_DIR)/polap-bash-$(BOLAP_TYPE)-graph.sh"
SCRIPT_GRAPH_PY := "$(POLAPLIB_DIR)/scripts/polap-py-$(BOLAP_TYPE)-graph-table.py"
SCRIPT_GRAPH_R := "$(POLAPLIB_DIR)/scripts/polap-r-$(BOLAP_TYPE)-graph.R"
SCRIPT_GRAPH_SUMMARY_R := "$(POLAPLIB_DIR)/scripts/polap-r-$(BOLAP_TYPE)-graph-summary.R"
SCRIPT_SHEET := "$(POLAPLIB_DIR)/polap-bash-$(BOLAP_TYPE)-ptmt-sheet.sh"


# ------------------------------------------------------------------------------
# Phony targets and default goal
#
# Declaring a target with .PHONY tells make two things:
# 1. Always execute the recipe: make knows the target doesn't represent a file,
#    so it always runs the commands associated with that target's recipe,
#    regardless of whether a file with that name exists.
# 2. Performance: It improves make's performance by skipping the file system
#    check.
# ------------------------------------------------------------------------------
.PHONY: help print-vars check-env manifests table-s1 pt-table mt-table \
	table-data figure-assembly figure-assemblies-pdf figure-assemblies-both \
	figure-assemblies-two-pages anno-scan sheet-ptmt fig1-puml fig1-r \
	clean

# The .DEFAULT_GOAL is a special make variable that specifies which target
# should be executed if the user invokes make without providing any arguments.
.DEFAULT_GOAL := help

# ------------------------------------------------------------------------------
# Help / diagnostics
# ------------------------------------------------------------------------------
# Example usage in a target:
help:
	@echo "bolap type: oatk ($(TIER_CLEAN)) workflow"
	@echo "Run from anywhere (SPECIES_ROOT defaults to $$PWD). Examples:"
	@echo "  make -f $(CURRENT_MAKEFILE) script"
	@echo "  make -f $(CURRENT_MAKEFILE) print-vars"
	@echo "  make -f $(CURRENT_MAKEFILE) manifest"
	@echo "  make -f $(CURRENT_MAKEFILE) table-data"
	@echo "  make -f $(CURRENT_MAKEFILE) sheet-ptmt"
	@echo "  make -f $(CURRENT_MAKEFILE) graph"
	@echo ""
	@echo "Species Code: $(SPECIES_CODES_TXT)"
	@echo ""
	@echo "Override vars: SPECIES_ROOT=/abs/root SET=auto|file:/abs/list.txt|<species> INUM=0 TIER=v6"

print-vars:
	@echo "TIER=$(TIER_CLEAN)"
	@echo "SET=$(SET_CLEAN)"
	@echo "INUM=$(INUM_CLEAN)"
	@echo "SPECIES_ROOT or SR=$(SR)"
	@echo "POLAP_SRC=$(POLAP_SRC)"
	@echo "POLAPLIB_DIR=$(POLAPLIB_DIR)"
	@echo "MANIFEST=$(MANIFEST_V6)"

check-env:
	@command -v bash >/dev/null 2>&1 || { echo "[ERR] bash missing" >&2; exit 2; }
	@command -v python3 >/dev/null 2>&1 || { echo "[ERR] python3 missing" >&2; exit 2; }
	@true

$(SPECIES_CODES_TXT): check-env # Added check-env as prerequisite here
	@echo "[INFO] Preparing $(SPECIES_CODES_TXT)"
	@find . -maxdepth 1 -type d -printf '%f\n' \
		| grep -E '^[A-Z][a-z]+_[a-z]+$$' \
		| sort \
		| bash $(POLAPLIB_DIR)/polap-bash-generate-species-codes.sh \
		>$(SPECIES_CODES_TXT)

script:
	@echo manifest: $(SCRIPT_MANIFEST)
	@echo manifest py: $(SCRIPT_MANIFEST_PY)

test:
	@cd TIPP && echo $$PWD

test2:
	@cd TIPP
	@echo $$PWD

# ------------------------------------------------------------------------------
# Manifest - result collection
# ------------------------------------------------------------------------------
# Target: manifest (A phony target - it's an action, not a file).
# Prerequisite: $(MANIFEST_V6) (The dynamic filename of the actual manifest file).
# Purpose: This rule creates a convenient, non-versioned alias or shortcut for
# the user. When the user types make manifest, make knows it needs to ensure the
# file named by $(MANIFEST_V6) exists and is up-to-date. The rule itself has no
# recipe, delegating all the work to its prerequisite.
manifest: $(MANIFEST_V6)

# Target: $(MANIFEST_V6) (The actual filename being generated, e.g.,
# manifests/v1.0.0-full.json).
# Prerequisites: check-env species_code (These are the necessary setup actions
# that must run before the manifest can be built).
# Recipe: This block contains all the shell commands required to create the file
# $@ ($(MANIFEST_V6)).
# Purpose: This rule is responsible for the file's creation logic and explicitly
# lists all the dependencies (check-env, species_code) required by that logic.
$(MANIFEST_V6): check-env $(SPECIES_CODES_TXT)
	@mkdir -p "$(MANIFEST_DIR)"
	@echo "[INFO] Building manifest tier=$(TIER_CLEAN) set=$(SET_CLEAN) in $(SR)"
	@echo "[INFO] bash script: ${SCRIPT_MANIFEST}" 
	@cd "$(SR)" && \
	  bash "$(SCRIPT_MANIFEST)" \
	    --species-codes  "$(SPECIES_CODES_TXT)" \
	    --tier "$(TIER_CLEAN)" \
	    --set  "$(SET_CLEAN)" \
	    --inum "$(INUM_CLEAN)" \
	    --out  "$(abspath $@)" \
	    --pretty \
	    2> "$(MANIFEST_LOG)" \
	    || { echo "[ERR] See $(abspath $(MANIFEST_LOG))"; exit 1; }
	@echo "[INFO] Wrote: $(abspath $@)"
	@echo "[INFO] Log:   $(abspath $(MANIFEST_LOG))"

# ------------------------------------------------------------------------------
# Table S1 (manifest -> TSV + MD via Python script)
# ------------------------------------------------------------------------------
#	polap-bash-format-table-dataset-summary.sh" \
.PHONY: table-s1
table-s1: $(TABLE_S1_TSV) $(TABLE_S1_MD)

$(TABLE_S1_TSV): $(MANIFEST_V6)
	@mkdir -p "$(dir $@)"
	@echo "[INFO] Building Table S1 from $(MANIFEST_V6)"
	python3 "$(POLAPLIB_DIR)/scripts/make_table_dataset_summary.py" \
	  --manifest "$(MANIFEST_V6)" \
	  --out "$(TABLE_S1_TSV)" \
	  --markdown
	@echo "[OK] Wrote: $(TABLE_S1_TSV) and $(TABLE_S1_MD)"
	@cp "$(TABLE_S1_MD)" "$(MAN5_MD)"

$(TABLE_S1_MD): $(TABLE_S1_TSV)
	@true

# ------------------------------------------------------------------------------
# PT summary (manifest -> TSV -> MD)
# ------------------------------------------------------------------------------

pt-table: $(PT_TABLE_MD)

$(PT_TABLE_MD): $(MANIFEST_V6)
	@mkdir -p "$(dir $@)"
	@echo "[INFO] PT summary (MD) from $(MANIFEST_V6)"
	@bash "$(POLAPLIB_DIR)/polap-bash-table-pt.sh" \
	  --manifest "$(MANIFEST_V6)" \
	  --tsv "$(PT_TABLE_TSV)" \
	  --md  "$(PT_TABLE_MD)"
	@echo "[OK] Wrote: $(PT_TABLE_MD)"

# ------------------------------------------------------------------------------
# MT summary (manifest -> TSV -> MD)
# ------------------------------------------------------------------------------
mt-table: $(MT_TABLE_TSV) $(MT_TABLE_MD)
	@echo "[OK] MT table: $(MT_TABLE_TSV) and $(MT_TABLE_MD)"

$(MT_TABLE_TSV) $(MT_TABLE_MD): $(MANIFEST_V6)
	@mkdir -p "$(dir $(MT_TABLE_TSV))"
	@echo "[INFO] MT summary from $(MANIFEST_V6)"
	@bash "$(POLAPLIB_DIR)/polap-bash-table-mt.sh" \
	  --manifest "$(MANIFEST_V6)" \
	  --tsv "$(MT_TABLE_TSV)" \
	  --md  "$(MT_TABLE_MD)"

# ------------------------------------------------------------------------------
# Data summary (long/short) (manifest -> TSV -> MD)
# ------------------------------------------------------------------------------
table-data: $(DATA_TABLE_MD)

$(DATA_TABLE_MD): $(MANIFEST_V6)
	@mkdir -p "$(dir $@)"
	@echo "[INFO] Data summary (TSV/MD) from $(MANIFEST_V6)"
	@bash "$(POLAPLIB_DIR)/polap-bash-table-data.sh" \
	  --manifest "$(MANIFEST_V6)" \
	  --out-tsv  "$(DATA_TABLE_TSV)" \
	  --out-md   "$(DATA_TABLE_MD)" \
	  --sort     "code2"
	@cut -f1,2,3,5 "$(DATA_TABLE_TSV)" > "$(DATA_TABLE_NO_BASE_TSV)"
	@tr '\t' ',' < "$(DATA_TABLE_NO_BASE_TSV)" > "$(DATA_TABLE_NO_BASE_TSV).csv"
	@pandoc "$(DATA_TABLE_NO_BASE_TSV).csv" -f csv -t markdown_mmd -o "$(DATA_TABLE_NO_BASE_MD)" 
	@echo "[OK] Wrote: $(DATA_TABLE_NO_BASE_TSV)"
	@echo "[OK] Wrote: $(DATA_TABLE_NO_BASE_MD)"

#-------------------------------------------------------------------------------
# PT/MT assembly graphs
#-------------------------------------------------------------------------------
anno-scan: $(MANIFEST_V6)
	@bash "$(POLAPLIB_DIR)/polap-bash-anno-scan.sh" \
	  --base-dir "." \
	  --manifest "$(MANIFEST_V6)" \
	  --manifest-tag "$(MANIFEST_TAG)" \
	  --out-dir "$(MANIFEST_DIR)" \
	  --tier "$(TIER_CLEAN)" --inum "$(INUM_CLEAN)"

# sheet-ptmt: $(MANIFEST_V6)
sheet-ptmt:
	@bash "$(SCRIPT_SHEET)" \
	  --manifest "$(MANIFEST_V6)" \
	  --species-codes "$(SPECIES_CODES_TXT)" \
	  --out "$(FIGURE_DIR)/$(MANIFEST_TAG)-sheet-ptmt.pdf" \
	  --gap-mm 4.0 --label-cex 1.00 --title-cex 1.0 \
	  --page-width-in 11 --page-height-in 8.5 --margin-in 1.5 \
	  --rows-per-page 2 \
	  --columns-per-page 4 \
	  --start-page 47 \
		--mt-only \
	  --title "Supplementary Materials - plant mitogenome assembly graphs"
	@cp "$(FIGURE_DIR)/$(MANIFEST_TAG)-sheet-ptmt.pdf" \
		"$(POLAPLIB_DIR)/figures"
	@cp "$(FIGURE_DIR)/$(MANIFEST_TAG)-sheet-ptmt.pdf" \
		"$(MAN5_FIGURE)/figures"

# --page-width-in 8.5 --page-height-in 11 --margin-in 1.5 \
# --rows-per-page 8 \
# --columns-per-page 6 \

#-------------------------------------------------------------------------------
# Boxplots
#-------------------------------------------------------------------------------
# --title "Mitogenome assembly QC metrics ($(TIER_CLEAN); PMAT, TIPPo, HiMT, Oatk)"
T_GRAPH := "$(FIGURE_DIR)/$(MANIFEST_TAG)-mt-graph.pdf"

graph: $(T_GRAPH)

$(T_GRAPH): $(MANIFEST_V6)
	@echo "[INFO] Building graph tier=$(TIER_CLEAN) set=$(SET_CLEAN) in $(SR)"
	@echo "[INFO] bash script: ${SCRIPT_GRAPH}" 
	@echo "[INFO] python script: ${SCRIPT_GRAPH_PY}" 
	@echo "[INFO] R script: ${SCRIPT_GRAPH_R}" 
	@bash "$(SCRIPT_GRAPH)" \
	  --manifest "$(MANIFEST_V6)" \
	  --out "$(FIGURE_DIR)/$(MANIFEST_TAG)-mt-graph.pdf" \
	  --out-tsv "$(MANIFEST_DIR)/$(MANIFEST_TAG)-mt-graph-summary.tsv" \
		--complete-threshold 0 \
	  --page-width-in 11 --page-height-in 8.5 --margin-in 0.5 \
		--title " "
	@cp "$(FIGURE_DIR)/$(MANIFEST_TAG)-mt-graph.pdf" \
		"$(POLAPLIB_DIR)/figures"
	@cp "$(FIGURE_DIR)/$(MANIFEST_TAG)-mt-graph.pdf" \
		"$(MAN5_FIGURE)"
	@echo "[INFO] Wrote: $(FIGURE_DIR)/$(MANIFEST_TAG)-mt-graph.pdf"

#-------------------------------------------------------------------------------
# pipeline schematic figure
#-------------------------------------------------------------------------------
fig1-puml:
	@plantuml -tsvg "$(POLAPLIB_DIR)/figure1-pipeline.puml" -o "$(SR)/md"
	@plantuml -tpng "$(POLAPLIB_DIR)/figure1-pipeline.puml" -o "$(SR)/md"
	@echo "[OK] Wrote: $(SR)/md/figure1-pipeline.svg and .png"

fig1-r:
	Rscript "$(POLAPLIB_DIR)/polap-r-figure1-pipeline.R"

###############################################################################
# Manuscript builder: polap-md-project00.md -> man/Polap-manuscript.pdf
# Requires: pandoc (and LaTeX installed; e.g., TeX Live). Optional: rsvg, citeproc, pandoc-crossref.
###############################################################################

.PHONY: manuscript
manuscript: manuscript.pdf

$(EXP_MD): $(MANIFEST_V6) $(DOC_MD) sheet-ptmt table-s1 table-data pt-table mt-table
	@bash "$(MAN_DIR)/sh/replace_include.sh" "$(DOC_MD)" >"$(EXP_MD)"

$(DOC_OUT_PDF): $(EXP_MD) 
	@command -v $(PANDOC) >/dev/null 2>&1 || { echo "[ERR] pandoc not found"; exit 2; }
	@mkdir -p "$(MAN_DIR)"
	@echo "[INFO] Building PDF: $@"
	{ \
	  BIB_OPT=""; CSL_OPT=""; XREF_OPT=""; \
	  BIB="$(MAN_DIR)/j-polap.bib"; \
	  CSL="$(MAN_DIR)/style.csl"; \
	  if [ -s "$$BIB" ]; then BIB_OPT="--citeproc --bibliography=$$BIB"; fi; \
	  if [ -s "$$CSL" ]; then CSL_OPT="--csl=$$CSL"; fi; \
	  if command -v pandoc-crossref >/dev/null 2>&1; then XREF_OPT="--filter pandoc-crossref"; fi; \
	  $(PANDOC) "$(EXP_MD)" \
	    --pdf-engine="$(PDF_ENGINE)" \
	    --resource-path="$(PANDOC_RPATH)" \
	    --toc --toc-depth=2 \
	    --number-sections \
			$$XREF_OPT \
	    $$BIB_OPT \
			$$CSL_OPT \
	    -V geometry:margin=1in \
	    -o "$(DOC_OUT_PDF)"; \
	}
	@echo "[OK] Wrote: $(DOC_OUT_PDF)"

manuscript.pdf: $(DOC_OUT_PDF) sheet-ptmt pt-table mt-table table-s1 table-data graph
	@pdfunite "$(DOC_OUT_PDF)" "$(FIGURE_DIR)/$(MANIFEST_TAG)-sheet-ptmt.pdf" manuscript.pdf
	@cp -p manuscript.pdf "$(CURDIR)/polap/src/polaplib/"

# ------------------------------------------------------------------------------
# Clean
# ------------------------------------------------------------------------------
clean:
	@rm -f -- "$(MANIFEST_V6)" "$(MANIFEST_LOG)" \
	         "$(TABLE_S1_TSV)" "$(TABLE_S1_MD)" \
	         "$(PT_TABLE_TSV)" "$(PT_TABLE_MD)" \
	         "$(MT_TABLE_TSV)" "$(MT_TABLE_MD)" \
	         "$(DATA_TABLE_TSV)" "$(DATA_TABLE_MD)" || true
	@echo "[OK] Cleaned"

